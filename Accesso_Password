#!/bin/bash

# Script per la creazione di un Prompt di Accesso con Password
tentativi=0
while [ true ]
do
	echo "Digita la Password"
	read dir

	if [ "$dir" = "1234" ];then
	echo "Password corretta: BENVENUTO/A"
	exit 0

	else
	tentativi=$((tentativi + 1))

	fi

	if [ "$tentativi" -gt 3 ];then
	echo "HAI DIGITATO LA PASSWORD 3 VOLTE.ACCESSO NEGATO"
	exit 1

	else
	echo "Password Errata"

	fi
done

